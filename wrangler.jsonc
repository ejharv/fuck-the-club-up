{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuck-the-club-up",
  // Wraps OpenNext's worker to add the cron (scheduled) handler.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Keep the workers.dev preview URL on (it turns off by default once routes exist).
  "workers_dev": true,

  // The real domain. Requires fucktheclubup.com to be an active zone in this
  // Cloudflare account, with no leftover A/AAAA/CNAME records on @ or www;
  // Cloudflare creates the DNS records and certificates.
  "routes": [
    { "pattern": "fucktheclubup.com", "custom_domain": true },
    { "pattern": "www.fucktheclubup.com", "custom_domain": true }
  ],

  // Posts, media rows and the crew list.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuck-the-club-up",
      // Fill in after `npx wrangler d1 create fuck-the-club-up`.
      "database_id": "4caa4e3b-9d91-4e78-9f1b-f01569991934",
      "migrations_dir": "migrations"
    }
  ],

  // MEDIA: published photos, videos and music, served at media.fucktheclubup.com.
  // INBOX: private. Party uploads and the shared album. No public domain, ever.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "fuck-the-club-up-media"
    },
    {
      "binding": "INBOX",
      "bucket_name": "fuck-the-club-up-inbox"
    }
  ],

  // Lets a drop copy files in batches, each in its own request (subrequest limits).
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "fuck-the-club-up" }],

  // 30 upload sign requests a minute per IP hash on party links.
  "ratelimits": [
    { "name": "DROP_LIMITER", "namespace_id": "4711", "simple": { "limit": 30, "period": 60 } }
  ],

  // Every 15 minutes: close finished party links, run scheduled drops.
  "triggers": { "crons": ["*/15 * * * *"] },

  // Non-secret config. Secrets are set with `wrangler secret put` (locally in
  // .dev.vars): AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, ADMIN_EMAILS,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, BEDROCK_ACCESS_KEY_ID,
  // BEDROCK_SECRET_ACCESS_KEY, TURNSTILE_SECRET_KEY,
  // CRON_SECRET. ADMIN_EMAILS is a secret only to keep emails out of this public repo.
  "vars": {
    "R2_BUCKET_NAME": "fuck-the-club-up-media",
    "INBOX_BUCKET_NAME": "fuck-the-club-up-inbox",
    "R2_ACCOUNT_ID": "0608b07bb3de61e3c8975befa6fe1c3f",
    "MEDIA_PUBLIC_URL": "",
    "BEDROCK_REGION": "us-east-1",
    "BEDROCK_MODEL_ID": "us.anthropic.claude-sonnet-4-6",
    // Public Turnstile site key (pairs with the TURNSTILE_SECRET_KEY secret).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGQBwIV3WcV8dw6u"
  }
}
